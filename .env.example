# Same Supabase project / schema as 13Stack (newsletter_subscribers)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_SCHEMA=thirteenstack

# Required once per Supabase project (Dashboard → Project Settings → API → Exposed schemas):
# add `thirteenstack`. Without that, PostgREST returns PGRST106 and waitlist upserts fail.
# Optional for migrations / DB tooling (same as 13Stack):
# SUPABASE_DB_URL=
# SUPABASE_DB_PASSWORD=